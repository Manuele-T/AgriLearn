<div class="hero">
    <div class="hero-content">
        <h1>Analyse your leaf here</h1>
        <p>Upload your picture using the related button and receive your analysis in seconds!</p>
    </div>
    <div class="hero-image">
        <img src="/img/Analysis_Crops.jpg" alt="Analysis">
    </div>
</div>

<!-- Main Content Wrapper -->
<div class="intro-text" style="text-align: justify;">
    <p><b>
                To upload your picture, select an image file and click the Upload Picture button. The website will
                analyze the
                leaf in your image and display the examination results.

                For the best results, make sure your image contains a single, clearly visible leaf without background
                distractions.
            </b></p>
</div>

<form class="form-row" id="uploadForm" action="/upload" method="POST" enctype="multipart/form-data">
    <input type="file" name="image" id="imageInput" required>
    <button type="submit" class="btn">Upload Picture</button>
</form>

<script>
document.getElementById("uploadForm").addEventListener("submit", function(event) {
  const fileInput = document.getElementById("imageInput");
  const file = fileInput.files[0];

  if (!file) {
    alert("Please select a file.");
    event.preventDefault();
    return;
  }

  const allowedTypes = ["image/jpeg", "image/jpg", "image/png", "image/heic", "image/heif"];
  const maxSize = 5 * 1024 * 1024; // 5MB

  if (!allowedTypes.includes(file.type)) {
    alert("Unsupported file type. Only JPEG, PNG, HEIC, and HEIF are allowed.");
    event.preventDefault();
    return;
  }

  if (file.size > maxSize) {
    alert("File too large. Maximum size is 5MB.");
    event.preventDefault();
    return;
  }
});
</script>

<div class="intro-text" style="text-align: justify;">
    <p><b>
                To check the list of supported crops, visit our Supported Crops page. Please note that the analysis
                results are
                not guaranteed to be 100% accurate.
            </b></p>
</div>

{{#if error}}
<script>
  alert("{{error}}");
</script>
{{/if}}
<!-- Hero Section -->
<div class="hero">
    <div class="hero-content">
        <h1>Welcome to AgriLearnPal</h1>
        <p>Explore crops, analyze images, and learn more about agriculture!</p>
    </div>
    <div class="hero-image">
        <img src="/img/home.jpg" alt="Farm field">
    </div>
</div>

<div class="content">
<p class="intro-text">
    <i><b>Explore each section by clicking an icon. Learn how to use the website, access valuable tips, and understand our mission. Before using the tool, you should check the list of crops that our algorithm can recognize.</i></b></p>
</div>
<!-- Clickable Navigation Boxes -->
<div class="clickable-container">
    <a href="/analyze" class="clickable-box">
        <img src="/img/Lens_icon.png" alt="Analyze Leaf">
        <p><b>Analyze Your Leaf</b></p>
    </a>
    <a href="/about" class="clickable-box">
        <img src="/img/About_Us_icon.png" alt="About Us">
        <p><b>About Us</b></p>
    </a>
    <a href="/tips" class="clickable-box">
        <img src="/img/All_Tips_icon.png" alt="All Tips">
        <p><b>All Tips</b></p>
    </a>

    <a href="/mission" class="clickable-box">
        <img src="/img/Our_Mission_icon.png" alt="Our Mission">
        <p><b>Our Missions</b></p>
    </a>

    <a href="/agricultureUK" class="clickable-box">
        <img src="/img/Agriculture_UK_icon.png" alt="Our Mission">
        <p><b>UK Agriculture</b></p>
    </a>

    <a href="/allcrops" class="clickable-box">
        <img src="/img/All_Crops_icon.png" alt="Our Mission">
        <p><b>All Supported Crops</b></p>
    </a>
</div>

<!-- Main Content Wrapper -->
<div class="content">
    <h1>Analyze Your Crops</h1>
    <p>
        Analyze your crop images or explore available crops using the side menu!
    </p>

    <!-- Upload Form -->
    <form action="/upload" method="POST" enctype="multipart/form-data">
        <input type="file" name="image" required>
        <button type="submit" class="btn">Upload Picture</button>
    </form>
</div>
